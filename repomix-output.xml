              notificacionesFiltradas.map((notif) => (
                <Card
                  key={notif.id}
                  className={`border-[#E5E7EB] hover:shadow-lg transition-all cursor-pointer ${
                    !notif.leida ? "bg-blue-50 border-blue-200" : "bg-white"

  // ── Gestión escolar ───────────────────────────────────────────────────────────
  { id: "asignar-alumnos", label: "Asignar Alumnos a Grupos", icon: UserPlus,      route: "#/asignar-alumnos",  permission: ["alumnos.manage"] },
